TMDB_API_KEY=your_tmdb_api_key

# Optional: IMDb ratings on title details (free key at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your_omdb_api_key

# Optional: Watch Party Realtime only. Local lists work without these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase client vars (Vite/next-style public prefix). Copy to .env locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: anime cache + privileged reads. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
